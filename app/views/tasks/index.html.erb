<div class="row mb-2">
  <div class="col-8">
    <h1 class="display-4">Tarefas</h1>
  </div>

  <div class="col-4 mt-4 text-end">
    <%= link_to "+ tarefa", new_task_path, class: "btn btn-success"%>
  </div>
</div>

<% if @tasks.any? %>
  <table class="table table-borderless">
    <thead>
      <tr>
        <th>Descrição</th>
        <th>Prazo</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @tasks.each do |task|%>
        <%= render "table_row", task: task%>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Nenhuma tarefa foi cadastrada.</p>
<% end %>
